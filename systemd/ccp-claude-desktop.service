[Unit]
Description=claude-projects-mcp: Claude desktop app on @DISPLAY@
After=ccp-xvfb.service ccp-wm.service ccp-keyring.service dbus.socket
Wants=ccp-wm.service ccp-keyring.service
Requires=ccp-xvfb.service
[Service]
Environment=DISPLAY=@DISPLAY@
Environment=BROWSER=@REPO@/bin/claude-signin-browser
Environment=CCP_CONFIG=@CONFIG_FILE@
ExecStartPre=/bin/sleep 2
ExecStart=@REPO@/bin/claude-desktop-launch
Restart=on-failure
RestartSec=10
[Install]
WantedBy=default.target
