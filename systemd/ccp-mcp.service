[Unit]
Description=claude-projects-mcp: MCP server (Streamable HTTP on @MCP_HOST@:@MCP_PORT@/mcp, bearer auth)
After=ccp-claude-desktop.service
[Service]
Environment=DISPLAY=@DISPLAY@
Environment=CCP_CONFIG=@CONFIG_FILE@
Environment=PYTHONWARNINGS=ignore
ExecStart=@REPO@/.venv/bin/python @REPO@/ccp_mcp.py
Restart=on-failure
RestartSec=5
Nice=5
MemoryMax=400M
[Install]
WantedBy=default.target
