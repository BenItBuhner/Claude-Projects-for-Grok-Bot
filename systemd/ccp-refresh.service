[Unit]
Description=claude-projects-mcp: background cache refresh (skips while a viewer is connected or the display was used <5 min ago)
[Service]
Type=oneshot
Environment=CCP_CONFIG=@CONFIG_FILE@
ExecStart=@REPO@/ccp refresh --background --max 3
Nice=10
IOSchedulingClass=idle
MemoryMax=300M
TimeoutStartSec=900
SuccessExitStatus=3 5
