#!/usr/bin/env bash
# claude-projects - Claude Code Projects CLI. Settings: ~/.config/claude-projects-mcp/config.json or CPG_* env (see cpg_config.py).
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"
export PYTHONWARNINGS=ignore
case ":$PATH:" in *:/snap/bin:*) ;; *) [ -d /snap/bin ] && PATH="$PATH:/snap/bin";; esac   # snaps (the sign-in browser)
PY="${CPG_PYTHON:-${CCP_PYTHON:-$HERE/.venv/bin/python}}"   # CCP_*: the old names still work
[ -x "$PY" ] || PY="$HERE/venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3)"
# `claude-projects [--json] setup ...` is the guided setup flow (standard library only, so it also runs before install.sh)
for a in "$@"; do case "$a" in --*) continue;; setup) exec "$PY" "$HERE/cpg_setup.py" "$@";; *) break;; esac; done
exec "$PY" "$HERE/cpg_core.py" "$@"
